## Environment Variables
PORT=3001
JWT_KEY=supersecretkey_example

## Third-party sign in (optional, any OpenID Connect provider)
## Register these with the provider:
##   redirect URI:             <APP_URL>/api/auth/callback
##   post-logout redirect URI: <APP_URL>/
# APP_URL=http://localhost:3000
# OIDC_PROVIDER_NAME=Google
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
## ...or, for local development only, the bundled mock provider (`npm run dev:idp`):
# OIDC_PROVIDER_NAME=Mock IdP
# OIDC_ISSUER=http://localhost:3002
# OIDC_CLIENT_ID=conduit-dev
# OIDC_CLIENT_SECRET=conduit-dev-secret

## Development Database
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=null
DEV_DB_NAME=database_development
DEV_DB_HOSTNAME=127.0.0.1
DEV_DB_DIALECT=mysql
DEV_DB_LOGGGIN=true

## Testing Database
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=null
TEST_DB_NAME=database_testing
TEST_DB_HOSTNAME=127.0.0.1
TEST_DB_DIALECT=mysql
TEST_DB_LOGGGIN=true

## Production Database
PROD_DB_USERNAME=root
PROD_DB_PASSWORD=null
PROD_DB_NAME=database_production
PROD_DB_HOSTNAME=127.0.0.1
PROD_DB_DIALECT=mysql
PROD_DB_LOGGGIN=false